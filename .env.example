# Copy to .env. Every default here works unmodified with `docker compose up`.
# Nothing in this file is a real secret — replace AUTH_SECRET and PAYMENT_WEBHOOK_SECRET
# before any deployment that is not a local demo.

# ---- database ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trial_booking
DATABASE_URL=postgres://postgres:postgres@db:5432/trial_booking

# Running Next.js on the host instead of in Compose? Use localhost:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trial_booking

# ---- auth -------------------------------------------------------------------
AUTH_SECRET=dev-auth-secret-replace-me
AUTH_URL=http://localhost:3000

# ---- application ------------------------------------------------------------
APP_TIMEZONE=Asia/Singapore
# Seats materialised per new class. Capacity is the row count, so this is the
# only place the number 4 appears.
DEFAULT_CLASS_SEATS=4

# ---- payments ---------------------------------------------------------------
PAYMENT_PROVIDER=stub
PAYMENT_STUB_URL=http://payments-stub:4001
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# How often the worker drains the refund queue.
REFUND_POLL_INTERVAL_MS=5000

# ---- seed data (development only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345

# ---- dashboard --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
DASHBOARD_PORT=3001

# ---- host port mappings -----------------------------------------------------
WEB_PORT=3000
DB_PORT=5432
PAYMENT_STUB_PORT=4001
