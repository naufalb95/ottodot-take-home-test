generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  TEACHER
  ADMIN
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum RefundReason {
  CLASS_FULL
  DUPLICATE_PAYMENT
  PARENT_CANCELLED
  CLASS_CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  students Student[]
  classes  TrialClass[]

  @@map("users")
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String   @map("parent_id") @db.Uuid
  name        String
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  parent   User      @relation(fields: [parentId], references: [id])
  bookings Booking[]

  @@map("students")
}

model TrialClass {
  id          String      @id @default(uuid()) @db.Uuid
  teacherId   String      @map("teacher_id") @db.Uuid
  title       String
  slug        String      @unique
  description String
  startsAt    DateTime    @map("starts_at") @db.Timestamptz()
  endsAt      DateTime    @map("ends_at") @db.Timestamptz()
  priceCents  Int         @map("price_cents")
  currency    String      @default("SGD") @db.Char(3)
  location    String
  ageMin      Int?        @map("age_min")
  ageMax      Int?        @map("age_max")
  status      ClassStatus @default(SCHEDULED)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  teacher  User      @relation(fields: [teacherId], references: [id])
  seats    Seat[]
  bookings Booking[]

  @@map("trial_classes")
}

model Seat {
  id           String  @id @default(uuid()) @db.Uuid
  trialClassId String  @map("trial_class_id") @db.Uuid
  bookingId    String? @unique @map("booking_id") @db.Uuid

  trialClass TrialClass @relation(fields: [trialClassId], references: [id], onDelete: Cascade)
  booking    Booking?   @relation(fields: [bookingId], references: [id])

  @@map("seats")
}

model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  trialClassId String        @map("trial_class_id") @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  status       BookingStatus @default(PENDING_PAYMENT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz()
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz()

  trialClass      TrialClass       @relation(fields: [trialClassId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id])
  seat            Seat?
  paymentAttempts PaymentAttempt[]

  @@map("bookings")
}

model PaymentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @map("booking_id") @db.Uuid
  provider      String        @default("stub")
  providerRef   String        @unique @map("provider_ref")
  amountCents   Int           @map("amount_cents")
  currency      String        @default("SGD") @db.Char(3)
  status        PaymentStatus @default(INITIATED)
  refundReason  RefundReason? @map("refund_reason")
  failureReason String?       @map("failure_reason")
  rawPayload    Json?         @map("raw_payload")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payment_attempts")
}
